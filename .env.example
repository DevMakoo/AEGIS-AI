# Copie este arquivo para .env e ajuste os valores localmente.
# Nunca versione o arquivo .env.

# Ambiente: development | test | production
AEGIS_ENV=development

# Nível de log: DEBUG | INFO | WARNING | ERROR | CRITICAL
AEGIS_LOG_LEVEL=INFO

# Diretório de logs (relativo à raiz do projeto ou absoluto)
AEGIS_LOG_DIR=logs

# Gravar logs em arquivo: true | false
AEGIS_LOG_TO_FILE=true

# Idioma da assistente (somente pt-BR nesta fase)
AEGIS_LANGUAGE=pt-BR

# ---------------------------------------------------------------------------
# Conversa inteligente (IA)
# ---------------------------------------------------------------------------

# Liga a conversa por IA. Desligada, o AEGIS funciona só com comandos.
AEGIS_AI_ENABLED=false

# Provedor de IA. Nesta fase, somente: ollama
AEGIS_AI_PROVIDER=ollama

# Endereço do servidor Ollama. Por padrão, só endereços locais (loopback) são aceitos.
AEGIS_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Permite um endereço fora deste computador (ex.: outro PC da rede).
# ATENÇÃO: com true, suas mensagens saem deste computador. Use apenas se souber o destino.
AEGIS_OLLAMA_ALLOW_REMOTE=false

# Modelo já instalado no Ollama (veja com: ollama list). Ex.: llama3.2
AEGIS_OLLAMA_MODEL=

# Tempo limite de cada resposta da IA, em segundos (1 a 600)
AEGIS_AI_TIMEOUT_SECONDS=60

# Mensagens de usuário/assistente mantidas na memória da sessão (2 a 200)
AEGIS_AI_MAX_HISTORY_MESSAGES=20

# Mensagem de sistema personalizada (opcional). Vazio usa a padrão do AEGIS.
AEGIS_AI_SYSTEM_PROMPT=

# Reservado para um provedor online (fase futura). Deixe vazio.
AEGIS_AI_API_KEY=
